    "electron-is-dev": "~3.0.1",
    "electron-json-storage": "^4.6.0",
    "electron-serve": "~3.0.1",
    "electron-unhandled": "~5.0.0",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.4.1",
    "electron-builder": "~26.15.3",
    "node-gyp": "^13.0.1",
    "typescript": "^7.0.2"
