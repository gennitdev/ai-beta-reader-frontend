  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc && electron-rebuild",
    "electron:start-live": "node ./live-runner.js",
    "electron:start": "electron ./",
    "electron:start:build": "npm run build && electron ./",
    "electron:start:debug": "electron --inspect=5858 ./",
