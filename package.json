{
  "name": "ai-beta-reader-frontend",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest run",
    "test:fuzz": "vitest run --config vitest.fuzz.config.ts",
    "benchmark:bundle": "tsx scripts/benchmarks/libraryBundleStress.ts --scale=smoke",
    "benchmark:bundle:ci": "tsx scripts/benchmarks/libraryBundleStress.ts --scale=ci --seed=132202608 --enforce",
    "benchmark:bundle:nightly": "tsx scripts/benchmarks/libraryBundleStress.ts --scale=nightly --seed=132202608",
    "test:coverage": "vitest run --coverage",
    "test:coverage:strict": "node scripts/check-strict-coverage.mjs --minimum=77.7",
    "test:electron": "vitest run electron/tests",
    "test:electron-security": "vitest run electron/tests/security-boundaries.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "validate:bundle": "tsx scripts/validate-bundle.ts",
    "type-check:e2e": "tsc -p e2e/tsconfig.json",
    "type-check:electron": "npm --prefix electron exec tsc -- --noEmit -p electron/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "copy:wasm": "cp node_modules/sql.js/dist/sql-wasm.wasm public/",
    "postinstall": "npm run copy:wasm && npm run build && npx cap sync android @capacitor-community/electron",
    "electron:dev": "npm run build && cd electron && npm run electron:start-live",
    "electron:build": "cd electron && npm run electron:make"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/crypto-js": "^4.2.2",
    "axios": "^1.19.0",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.14",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "identicon.js": "^2.3.3",
    "jszip": "^3.10.1",
    "markdown-it": "^15.0.0",
    "openai": "^7.5.0",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vuedraggable": "^4.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/identicon.js": "^2.3.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.26",
    "tsx": "^4.23.12",
    "typescript": "~5.8.0",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10"
  }
}
