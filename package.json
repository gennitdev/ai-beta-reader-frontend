{
  "name": "ai-beta-reader-frontend",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "copy:wasm": "cp node_modules/sql.js/dist/sql-wasm.wasm public/",
    "postinstall": "npm run copy:wasm && npm run build && npx cap sync android @capacitor-community/electron",
    "electron:dev": "npm run build && cd electron && npm run electron:start-live",
    "electron:build": "cd electron && npm run electron:make"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.1",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/app-launcher": "^7.0.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/clipboard": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/vue-query": "^5.101.4",
    "@types/crypto-js": "^4.2.2",
    "@types/jszip": "^3.4.0",
    "axios": "^1.12.2",
    "crypto-js": "^4.2.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "identicon.js": "^2.3.3",
    "jszip": "^3.10.1",
    "markdown-it": "^15.0.0",
    "openai": "^7.4.0",
    "pinia": "^4.0.2",
    "sql.js": "^1.14.1",
    "tailwindcss": "^3.4.17",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/identicon.js": "^2.3.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.6",
    "typescript": "~5.8.0",
    "vite": "^8.2.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.9"
  }
}
